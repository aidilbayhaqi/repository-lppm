# Local-only Docker setup. Copy to .env.docker; do not use on a public server.
APP_NAME="OSDJ LPPM"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_KEY=
APP_LOCALE=id
LOG_CHANNEL=stderr
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=repository_local
DB_USERNAME=root
DB_PASSWORD=
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_BLOCK=true
SESSION_BLOCK_STORE=redis
QUEUE_CONNECTION=database
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=admin@repository.test
MAIL_FROM_NAME="OSDJ LPPM"
REGISTRATION_ENABLED=true
REQUIRE_VERIFIED_EMAIL=true
DOCUMENT_SCAN_REQUIRED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
FILESYSTEM_DISK=local
DOCUMENTS_DISK=local
REPOSITORY_DOCUMENT_ROOT=/var/www/html/storage/app/private
