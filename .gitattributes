* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Exclude optional PowerShell maintenance scripts from GitHub language statistics.
*.ps1 -linguist-detectable
*.psm1 -linguist-detectable
*.psd1 -linguist-detectable
