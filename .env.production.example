# Copy to .env.production. Fill all empty secrets independently; never commit the result.
APP_NAME="OSDJ LPPM UMIBA"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_HOST=repository.example.org
APP_URL=https://repository.example.org
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
RELEASE_TAG=1.6.1
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis
LOG_CHANNEL=stderr
LOG_LEVEL=info
BCRYPT_ROUNDS=12

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=repository
DB_USERNAME=repository
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
CACHE_STORE=redis
CACHE_PREFIX=osdj-cache-
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_STORE=redis
SESSION_LIFETIME=30
SESSION_ABSOLUTE_MINUTES=480
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_EXPIRE_ON_CLOSE=true
SESSION_COOKIE=osdj_session
SESSION_DOMAIN=null
SESSION_PATH=/
SESSION_BLOCK=true
SESSION_BLOCK_STORE=redis
AUTH_PASSWORD_TIMEOUT=900

# A durable database queue avoids sharing Redis eviction/failure policy with publishing jobs.
QUEUE_CONNECTION=database
REGISTRATION_ENABLED=false
REQUIRE_VERIFIED_EMAIL=true
# MFA is required for privileged accounts. Test admin enrollment and recovery on staging before rollout.
MFA_ENABLED=true
# Leave blank with the supplied TLS + FastCGI configuration. For an external HTTP proxy, allow only its CIDR.
TRUSTED_PROXIES=
FILESYSTEM_DISK=local
DOCUMENTS_DISK=local
REPOSITORY_DOCUMENT_ROOT=/var/www/html/storage/app/private
DOCUMENT_SCAN_REQUIRED=true
# Limits include retained document versions and soft-deleted PDFs; no automatic deletion.
DOCUMENT_MAX_FILES_PER_WORK=50
DOCUMENT_MAX_VERSIONS_PER_FILE=20
DOCUMENT_MAX_STORAGE_MB_PER_WORK=500
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=15

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
